# Copy to .env.local and fill in. Never commit .env.local.

# ── Line Betting tab ─────────────────────────────────────────────────────────
# Sportsbook player-prop prices (DraftKings, FanDuel, BetMGM, Caesars, …).
# Free key: https://the-odds-api.com  (free tier = 500 credits / month)
ODDS_API_KEY=
# Optional tuning (defaults shown). Each game's prop odds costs
# (#markets × #regions) credits; results are cached for ODDS_API_TTL_MIN.
# ODDS_API_REGIONS=us
# ODDS_API_TTL_MIN=20
# ODDS_API_MAX_EVENTS=16

# Kalshi — public market reads work without these; signing is optional.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# ── Other ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
BALLDONTLIE_API_KEY=
